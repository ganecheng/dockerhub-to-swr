# 源码编译 PyTorch wheel，仅包含指定 GPU 架构的 CUDA kernel（默认 Blackwell sm_120 = RTX 50 系）
# 编译产物发布到 GitHub Release 供 pytorch/Dockerfile 复用，避免每次镜像构建重复编译
# 由 .github/workflows/pytorch-wheel.yml 调用，单次编译耗时约 2-4 小时
FROM nvidia/cuda:13.3.1-cudnn-devel-ubuntu26.04

ARG TORCH_VERSION=2.12.1
ARG CUDA_ARCH=12.0
ARG MAX_JOBS=4

ENV DEBIAN_FRONTEND=noninteractive

# 安装编译依赖
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-dev \
    build-essential cmake ninja-build git pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 浅克隆 PyTorch 源码（版本由 TORCH_VERSION 决定，升级时改 workflow 输入参数）
RUN git clone --recursive --depth 1 --shallow-submodules \
    --branch "v${TORCH_VERSION}" \
    https://github.com/pytorch/pytorch /tmp/pytorch

WORKDIR /tmp/pytorch

# 安装 Python 构建依赖
RUN pip install --no-cache-dir --break-system-packages pyyaml numpy setuptools wheel

# 只编译 CUDA_ARCH 对应架构（12.0 = sm_120），跳过其他所有架构，大幅减小编译产物
ENV TORCH_CUDA_ARCH_LIST=${CUDA_ARCH}
# 并行编译任务数，构建机内存不足时调低
ENV MAX_JOBS=${MAX_JOBS}

# 编译 wheel，产物位于 /tmp/pytorch/dist/
RUN python setup.py bdist_wheel
